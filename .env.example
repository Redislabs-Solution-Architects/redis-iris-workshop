# ═══════════════════════════════════════════════════
#  DOMAIN SELECTION
#  Choose your workshop domain: digital-native, healthcare, retail, finance, banking
# ═══════════════════════════════════════════════════

DEMO_DOMAIN=digital-native

# ═══════════════════════════════════════════════════
#  MODULE 0: Setup
#  Fill these in during the initial setup module.
# ═══════════════════════════════════════════════════

# OpenAI — use the key provided by your instructor
OPENAI_API_KEY=

# Redis Cloud — from your free-tier database
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL=false

# ═══════════════════════════════════════════════════
#  MODULE 2: Semantic Routing
#  Enable the guardrail after completing Module 2.
# ═══════════════════════════════════════════════════

GUARDRAIL_ENABLED=false

# ═══════════════════════════════════════════════════
#  MODULE 3: Context Retriever
#  Create a surface in the Console, then copy your
#  admin key and surface ID. Run `make setup-surface`
#  to complete the surface.
# ═══════════════════════════════════════════════════

CTX_ADMIN_KEY=
CTX_SURFACE_ID=

# ═══════════════════════════════════════════════════
#  MODULE 4: LangCache
#  Fill these in after creating a LangCache instance.
# ═══════════════════════════════════════════════════

LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
LANGCACHE_THRESHOLD=0.82

# ═══════════════════════════════════════════════════
#  MODULE 5: Agent Memory
#  Fill these in after creating an Agent Memory store.
# ═══════════════════════════════════════════════════

MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=

# ═══════════════════════════════════════════════════
#  Defaults — change only if needed
# ═══════════════════════════════════════════════════

# Auto-populated by `make setup-surface`
MCP_AGENT_KEY=

# Agent Memory defaults (namespace auto-derives from DEMO_DOMAIN if empty)
MEMORY_OWNER_ID=
MEMORY_ACTOR_ID=
MEMORY_NAMESPACE=
MEMORY_SIMILARITY_THRESHOLD=0.2
MEMORY_LIMIT=6

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_USERNAME=default
REDIS_DB=0
BACKEND_PORT=8040
FRONTEND_PORT=3040
CORS_ORIGIN=

# Context Surface defaults (used by make setup-surface)
CTX_SURFACE_NAME=
CTX_AGENT_NAME=
REDIS_INSTANCE_NAME=
CTX_REDIS_INSTANCE_ID=
CTX_FORCE_CREATE=false
DEMO_USER_ID=
DEMO_USER_NAME=
DEMO_USER_EMAIL=
