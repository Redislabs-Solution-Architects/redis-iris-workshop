# ═══════════════════════════════════════════════════
#  MODULE 0: Setup
#  Fill these in during the initial setup module.
# ═══════════════════════════════════════════════════

# OpenAI — use the key provided by your instructor
OPENAI_API_KEY=

# Redis Cloud — from your free-tier database
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL=false

# ═══════════════════════════════════════════════════
#  MODULE 2: Semantic Routing
#  Enable the guardrail after completing Module 2.
# ═══════════════════════════════════════════════════

GUARDRAIL_ENABLED=false

# ═══════════════════════════════════════════════════
#  MODULE 3: LangCache
#  Fill these in after creating a LangCache instance.
# ═══════════════════════════════════════════════════

LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
LANGCACHE_THRESHOLD=0.82

# ═══════════════════════════════════════════════════
#  MODULE 4: Context Retriever
#  Fill in CTX_ADMIN_KEY, then run `make setup-surface`.
#  CTX_SURFACE_ID and MCP_AGENT_KEY are auto-populated.
# ═══════════════════════════════════════════════════

CTX_ADMIN_KEY=
CTX_SURFACE_ID=
MCP_AGENT_KEY=

# ═══════════════════════════════════════════════════
#  MODULE 5: Agent Memory
#  Fill these in after creating an Agent Memory store.
# ═══════════════════════════════════════════════════

MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=
MEMORY_OWNER_ID=CUST_DEMO_001
MEMORY_ACTOR_ID=reddash-agent
MEMORY_NAMESPACE=reddash-demo
MEMORY_SIMILARITY_THRESHOLD=0.5
MEMORY_LIMIT=6

# ═══════════════════════════════════════════════════
#  Defaults — change only if needed
# ═══════════════════════════════════════════════════

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_USERNAME=default
REDIS_DB=0
DEMO_DOMAIN=reddash
BACKEND_PORT=8040
FRONTEND_PORT=3040
CORS_ORIGIN=

# Context Surface defaults (used by make setup-surface)
CTX_SURFACE_NAME="Reddash Delivery Surface"
CTX_AGENT_NAME="Reddash Delivery Agent"
REDIS_INSTANCE_NAME="Reddash Redis Cloud"
CTX_REDIS_INSTANCE_ID=
CTX_FORCE_CREATE=false
DEMO_USER_ID=
DEMO_USER_NAME=
DEMO_USER_EMAIL=
